def calcular_total_supermercado():
    # Solicita a distância de entrega
    distancia = float(input("Digite a distância de entrega (em km): "))
    
    total_produtos = 0
    print("Digite o preço dos produtos (ou digite 0 para encerrar):")
    
    # Loop para somar os produtos até digitar zero
    while True:
        preco = float(input("Preço do produto: R$ "))
        if preco == 0:
            break
        total_produtos += preco
        
    # Regra de cálculo do frete
    if distancia <= 50:
        frete = distancia * 2.00
    else:
        frete = distancia * 1.80
        
    total_compra = total_produtos + frete
    
    print(f"\nTotal em produtos: R$ {total_produtos:.2f}")
    print(f"Valor do frete: R$ {frete:.2f}")
    print(f"Valor total da compra (com frete): R$ {total_compra:.2f}")

# Executa a função
calcular_total_supermercado()


